{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://jobmonitor.com/schemas/api/alert-rule-request.json",
  "title": "AlertRuleRequest",
  "description": "Request body for POST /api/v1/alerts/rules — create a new alert rule",
  "type": "object",
  "required": ["name", "condition", "severity", "channels"],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "description": "Alert rule name"
    },
    "condition": {
      "type": "string",
      "description": "Alert condition expression (e.g., 'job.status == FAILED', 'execution.duration > 3600s')"
    },
    "severity": {
      "type": "string",
      "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "INFO"]
    },
    "channels": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["EMAIL", "SMS", "SLACK", "PUSH", "WEBHOOK"]
      },
      "minItems": 1,
      "description": "Notification channels to fire when alert is triggered"
    },
    "description": {
      "type": ["string", "null"],
      "maxLength": 1000
    },
    "cooldownMinutes": {
      "type": ["integer", "null"],
      "minimum": 1,
      "description": "Minimum minutes between re-triggering this rule"
    },
    "enabled": {
      "type": "boolean",
      "default": true
    }
  },
  "additionalProperties": false
}
