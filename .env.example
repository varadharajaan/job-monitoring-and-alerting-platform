# ═══════════════════════════════════════════════════════════════════════════
#  Job Monitoring & Alerting Platform — Environment Variables
#  
#  INSTRUCTIONS:
#  1. Copy this file:  cp .env.example .env
#  2. Fill in ALL values below
#  3. NEVER commit .env to version control (.gitignore already excludes it)
#
#  SECRET MANAGEMENT:
#  - Local:  .env file (this pattern)
#  - CI/CD:  GitHub Secrets → injected as env vars
#  - Prod:   AWS Secrets Manager / SSM Parameter Store
#  - Config: Spring Cloud Config Server for non-secret shared config
# ═══════════════════════════════════════════════════════════════════════════

# ── Spring Profile ──
SPRING_PROFILES_ACTIVE=local

# ── PostgreSQL / TimescaleDB ──
POSTGRES_DB=jobmonitor
POSTGRES_USER=jobmonitor
POSTGRES_PASSWORD=<CHANGE_ME_GENERATE_STRONG_PASSWORD>

# ── Application Database (same as above for local, different for prod) ──
DB_URL=jdbc:postgresql://localhost:5432/jobmonitor
DB_USERNAME=jobmonitor
DB_PASSWORD=<CHANGE_ME_GENERATE_STRONG_PASSWORD>

# ── Redis ──
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=<CHANGE_ME_GENERATE_STRONG_PASSWORD>

# ── Kafka ──
KAFKA_BOOTSTRAP=localhost:9092

# ── JWT (auth-service) — generate with: openssl rand -base64 64 ──
JWT_SECRET=<CHANGE_ME_GENERATE_MIN_256_BIT_SECRET>
JWT_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=86400000

# ── Config Server ──
CONFIG_USER=config
CONFIG_PASSWORD=<CHANGE_ME_GENERATE_STRONG_PASSWORD>

# ── SMTP (local: use MailHog on port 1025, no auth) ──
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_TLS=false
EMAIL_FROM=noreply@jobmonitor.local

# ── Slack (optional for local dev) ──
SLACK_WEBHOOK_URL=
SLACK_DEFAULT_CHANNEL=#alerts

# ── S3 / LocalStack ──
S3_ENABLED=true
S3_BUCKET=job-monitor-logs
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:4566

# ── Grafana ──
GRAFANA_ADMIN_PASSWORD=<CHANGE_ME_GENERATE_STRONG_PASSWORD>

# ── AWS (production only — leave empty for local) ──
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=     # Use IAM roles in prod, not keys
# AWS_SECRET_ACCESS_KEY= # Use IAM roles in prod, not keys

# ── SES SMTP (production only) ──
# SES_SMTP_USERNAME=
# SES_SMTP_PASSWORD=

# ── Rate Limiting ──
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPM=60
RATE_LIMIT_BURST=10
